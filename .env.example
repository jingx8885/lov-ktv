# 复制为 .env 后按需填写。不要提交真实密钥。

LOVKTV_PUBLIC_URL=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
LOVKTV_AGENT_URL=
LOVKTV_AGENT_KEY=
LOVKTV_AGENT_MODEL=
# 落地页 APK 上传。不要打印真实值。空则 POST /api/apps/{tv|phone} 返回 503。
LOVKTV_APP_UPLOAD_TOKEN=
ALIYUN_OSS_ENABLED=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_DOWNLOAD_DOMAIN=
LOVKTV_OSS_PREFIX=lovktv
# 生产机房访问网易 / YouTube 走 43 上 lov-stock 的 Clash 边车。
# LOVKTV_HTTPS_PROXY=http://lov-stock-clash:7890

# 线上 PostgreSQL / Supabase。空则用 data/lovktv.sqlite。测试始终走 SQLite。
# LOVKTV_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
