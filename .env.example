# 复制为 .env 后按需填写。不要提交真实密钥。

LOVKTV_PUBLIC_URL=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
LOVKTV_AGENT_URL=
LOVKTV_AGENT_KEY=
LOVKTV_AGENT_MODEL=
# 主模型（生产默认 gpt-5.6-luna）超时或网关报错时，对齐和日语注音改用这个模型。
LOVKTV_AGENT_FALLBACK_MODEL=grok-4.6
# 单次等待模型返回的秒数。整首歌对齐和日语注音经常超过 3 分钟。
LOVKTV_AGENT_TIMEOUT=360
# 远程 ASR：fish-transcribe-1 或 grok-stt；默认使用 grok-stt，通过 Agent 的 /v1/audio/transcriptions 调用。
LOVKTV_ASR_MODEL=grok-stt
# 远程 ASR 失败时使用的本地 faster-whisper 兜底模型与精度。
LOVKTV_WHISPER_MODEL=small
LOVKTV_WHISPER_COMPUTE_TYPE=int8
# 落地页 APK 上传。不要打印真实值。空则 POST /api/apps/{tv|phone} 返回 503。
LOVKTV_APP_UPLOAD_TOKEN=
# 广告外链默认关闭。设为 1 才从广告跳到落地页 / APK。
# LOVKTV_ADS_OPEN=1
ALIYUN_OSS_ENABLED=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_DOWNLOAD_DOMAIN=
LOVKTV_OSS_PREFIX=lovktv
# 生产机房访问网易 / YouTube 走 43 上 lov-stock 的 Clash 边车。
# LOVKTV_HTTPS_PROXY=http://lov-stock-clash:7890

# 线上 PostgreSQL / Supabase。空则用 data/lovktv.sqlite。测试始终走 SQLite。
# LOVKTV_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_5=
STRIPE_PRICE_20=
# Google Identity Services OAuth web client
GOOGLE_CLIENT_ID=
# LovBrowser OIDC（可选；在主站注册 client，redirect URI 必须精确匹配）
LOVBROWSER_OIDC_ISSUER=https://lovbrowser.com/api
LOVBROWSER_OIDC_CLIENT_ID=
LOVBROWSER_OIDC_CLIENT_SECRET=
LOVBROWSER_OIDC_DISCOVERY_URL=
LOVBROWSER_OIDC_STATE_SECRET=
LOVBROWSER_OIDC_SCOPES=openid profile email
# 允许调用 KTV API 的浏览器来源（逗号分隔；不要使用 *）
LOVKTV_CORS_ORIGINS=https://ktv.lovbrowser.com,https://lovbrowser.com,https://www.lovbrowser.com
