<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05060C">

    <ImageView
        android:id="@+id/adImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/splash_desc"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_art" />

    <TextView
        android:id="@+id/adSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_margin="16dp"
        android:background="#73000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/ad_skip"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D9000000"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/adKind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ad_splash"
            android:textColor="#9AA3B5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/adTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#C8CDD8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/adTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#F5C16C"
            android:textSize="13sp" />

        <Button
            android:id="@+id/adJump"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="#FF4D8D"
            android:text="@string/ad_jump"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
