{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "types/**/*.d.ts",
    "public/phone/**/*.js",
    "public/tv/**/*.js",
    "public/shared/ui/**/*.js",
    "public/shared/ads/**/*.js",
    "public/shared/lyrics/**/*.js",
    "public/phone/player/js/playback/timeline.js",
    "public/shared/fx/**/*.js",
    "public/login/**/*.js",
    "public/admin/**/*.js",
    "public/landing/**/*.js"
  ],
  "exclude": ["public/vendor/**", "public/shared/audio/**"]
}
